{
  "name": "theoretical-physics-web",
  "private": true,
  "version": "0.2.0",
  "description": "Plataforma web para construir fórmulas de física teórica, calcular e simular modelos físicos.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/screen-orientation": "^8.0.2",
    "@types/node": "^26.6.5",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "katex": "^0.19.0",
    "mathjs": "^15.2.0",
    "plotly.js-dist-min": "^4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "main": "electron/main.cjs",
  "author": "fishing-ainpm",
  "build": {
    "appId": "com.fishingainpm.fisicateorica",
    "productName": "Fisica Teorica",
    "copyright": "fishing-ainpm",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Física Teórica",
      "artifactName": "FisicaTeorica-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "FisicaTeorica-Portatil-${version}.exe"
    },
    "publish": null
  }
}
